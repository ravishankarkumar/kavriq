---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
---

<Layout>
  <Header />
  <main id="main-content" data-layout="index" class="app-layout">
    <section
      id="hero"
      class="landing-hero grid items-center gap-8 pt-8 pb-6 sm:pt-10 lg:pt-12"
    >
      <div class="max-w-4xl">
        <p
          class="tech-label mb-4 text-xs font-semibold tracking-[0.2em] text-accent uppercase"
        >
          Learn from first principles
        </p>
        <h1
          class="max-w-4xl text-3xl font-semibold tracking-tight sm:text-4xl lg:text-5xl"
        >
          Maths, Software Systems &amp; AI
        </h1>
        <p class="mt-4 max-w-3xl text-base leading-7 text-foreground/72">
          First-principles explanations of the mathematics, models, and systems
          behind modern AI.
        </p>
      </div>

      <div class="kavriq-hero-brand" aria-hidden="true">
        <video
          class="kavriq-hero-animation"
          autoplay
          loop
          muted
          playsinline
          preload="metadata"
          poster="/brand/kavriq-logo.png"
        >
          <source src="/brand/kavriq-logo-splash.webm" type="video/webm" />
        </video>
        <img
          class="kavriq-hero-static"
          src="/brand/kavriq-logo.png"
          alt=""
          width="1200"
          height="1200"
        />
      </div>
    </section>

    <section class="pt-5 pb-14 lg:pb-18">
      <div class="grid gap-4 md:grid-cols-3">
        <a
          href="/learning"
          class="surface-panel group block rounded-2xl border border-border p-6 transition-colors hover:border-accent/50 sm:p-7"
        >
          <p
            class="tech-label text-xs font-semibold tracking-[0.18em] text-accent uppercase"
          >
            01
          </p>
          <h2 class="mt-5 text-2xl font-semibold tracking-tight">Learning</h2>
          <p class="mt-3 text-sm leading-6 text-foreground/68">
            Follow structured paths from first principles to working intuition.
          </p>
          <span class="mt-8 inline-flex text-sm font-medium text-accent">
            Start learning
          </span>
        </a>
        <a
          href="/engineering"
          class="surface-panel group block rounded-2xl border border-border p-6 transition-colors hover:border-accent/50 sm:p-7"
        >
          <p
            class="tech-label text-xs font-semibold tracking-[0.18em] text-accent uppercase"
          >
            02
          </p>
          <h2 class="mt-5 text-2xl font-semibold tracking-tight">
            Engineering
          </h2>
          <p class="mt-3 text-sm leading-6 text-foreground/68">
            Use practical references for designing, debugging, and maintaining
            AI systems.
          </p>
          <span class="mt-8 inline-flex text-sm font-medium text-accent">
            Open handbooks
          </span>
        </a>
        <a
          href="/blogs"
          class="surface-panel group block rounded-2xl border border-border p-6 transition-colors hover:border-accent/50 sm:p-7"
        >
          <p
            class="tech-label text-xs font-semibold tracking-[0.18em] text-accent uppercase"
          >
            03
          </p>
          <h2 class="mt-5 text-2xl font-semibold tracking-tight">Blogs</h2>
          <p class="mt-3 text-sm leading-6 text-foreground/68">
            Read essays, notes, and observations on how the field is changing.
          </p>
          <span class="mt-8 inline-flex text-sm font-medium text-accent">
            Browse essays
          </span>
        </a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>
